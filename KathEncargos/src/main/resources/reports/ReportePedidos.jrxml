<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReportePedidos" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="TableHeader" mode="Opaque" backcolor="#f4f4f4">
        <box leftPadding="6" rightPadding="6" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.5" lineColor="#9e9e9e"/>
        </box>
    </style>

    <style name="TableCell">
        <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6">
            <pen lineWidth="0.5" lineColor="#c5c5c5"/>
        </box>
    </style>


    <field name="fechaHoraCreacion" class="java.time.LocalDateTime"/>
    <field name="horaEstimadaRetiro" class="java.time.LocalDateTime"/>
    <field name="totalProductos" class="java.lang.Integer"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="montoTotal" class="java.math.BigDecimal"/>
    <field name="tipoPedido.nombreTipoPedido" class="java.lang.String"/>
    <field name="estadoPedido.nombreEstado" class="java.lang.String"/>
    <field name="usuario.nombreUsuario" class="java.lang.String"/>

    <title>
        <band height="90">
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="70" height="70"/>
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="80" y="8" width="480" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Pedidos]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="40" width="480" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Resumen de pedidos con cantidad de productos y montos.]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="8" width="240" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new
java.util.Date())]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>

        <band height="40">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="52" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="52" y="0" width="90" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Tipo pedido]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="142" y="0" width="90" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="232" y="0" width="120" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha hora creación]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="352" y="0" width="120" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Hora estimada retiro]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="472" y="0" width="80" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total productos]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="552" y="0" width="160" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Observaciones]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="712" y="0" width="90" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Monto total]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="32">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="52" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{usuario.nombreUsuario}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="52" y="0" width="90" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{tipoPedido.nombreTipoPedido}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="142" y="0" width="90" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{estadoPedido.nombreEstado}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="232" y="0" width="120" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{fechaHoraCreacion}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="352" y="0" width="120" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{horaEstimadaRetiro}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="472" y="0" width="80" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{totalProductos}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="552" y="0" width="160" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>

            <textField pattern="$ #,##0.00">
                <reportElement style="TableCell" x="712" y="0" width="90" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{montoTotal}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>