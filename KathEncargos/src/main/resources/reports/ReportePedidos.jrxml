<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReportePedidos" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

<!-- Campos simples de Pedido -->
<style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<style name="TableCell">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<field name="idPedido" class="java.lang.Long"/>
<field name="fechaHoraCreacion" class="java.time.LocalDateTime"/>
<field name="totalProductos" class="java.lang.Integer"/>
<field name="montoTotal" class="java.math.BigDecimal"/>

<title>
    <band height="240">
        <staticText>
            <reportElement x="0" y="0" width="802" height="40"/>
            <textElement textAlignment="Center">
                <font size="20" isBold="true"/>
            </textElement>
            <text><![CDATA[Reporte de Pedidos]]></text>
        </staticText>

        <textField>
            <reportElement x="562" y="0" width="240" height="20"/>
            <textElement textAlignment="Right" verticalAlignment="Middle">
                <font size="10" isBold="true"/>
            </textElement>
            <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
        </textField>

        <image scaleImage="RetainShape">
            <reportElement x="286" y="50" width="230" height="180"/>
            <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
        </image>
    </band>
</title>

<columnHeader>
    <band height="24">
        <staticText>
            <reportElement style="TableHeader" x="0" y="0" width="70" height="24"/>
            <text><![CDATA[ID]]></text>
        </staticText>

        <staticText>
            <reportElement style="TableHeader" x="80" y="0" width="240" height="24"/>
            <text><![CDATA[Fecha]]></text>
        </staticText>

        <staticText>
            <reportElement style="TableHeader" x="330" y="0" width="140" height="24"/>
            <text><![CDATA[Items]]></text>
        </staticText>

        <staticText>
            <reportElement style="TableHeader" x="480" y="0" width="322" height="24"/>
            <text><![CDATA[Monto total]]></text>
        </staticText>

    </band>
</columnHeader>

<detail>
    <band height="22">
        <textField>
            <reportElement style="TableCell" x="0" y="0" width="70" height="22"/>
            <textFieldExpression><![CDATA[$F{idPedido}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement style="TableCell" x="80" y="0" width="240" height="22"/>
            <textFieldExpression><![CDATA[$F{fechaHoraCreacion}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement style="TableCell" x="330" y="0" width="140" height="22"/>
            <textFieldExpression><![CDATA[$F{totalProductos}]]></textFieldExpression>
        </textField>

        <textField>
            <reportElement style="TableCell" x="480" y="0" width="322" height="22"/>
            <textFieldExpression><![CDATA[$F{montoTotal}]]></textFieldExpression>
        </textField>

    </band>
</detail>

</jasperReport>