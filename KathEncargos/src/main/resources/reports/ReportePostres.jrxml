<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReportePostres" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Mismos estilos que ReporteUsuarios -->
    <style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <style name="TableCell">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <!-- Campos de la entidad Postre -->
    <field name="id" class="java.lang.Long"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="activo" class="java.lang.Boolean"/>
    <field name="precio" class="java.math.BigDecimal"/>

    <!-- Título con mismo estilo y logo -->
    <title>
        <band height="240">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Postres]]></text>
            </staticText>
            <image scaleImage="RetainShape">
                <reportElement x="286" y="50" width="230" height="180"/>
                <!-- Mismo logo que en ReporteUsuarios -->
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <!-- Encabezado de tabla con bordes -->
    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="60" height="24"/>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="70" y="0" width="200" height="24"/>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="280" y="0" width="250" height="24"/>
                <text><![CDATA[Descripción]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="540" y="0" width="80" height="24"/>
                <text><![CDATA[Activo]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="630" y="0" width="120" height="24"/>
                <text><![CDATA[Precio]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalle con las filas y bordes -->
    <detail>
        <band height="22">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="60" height="22"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="70" y="0" width="200" height="22"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="280" y="0" width="250" height="22"/>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="540" y="0" width="80" height="22"/>
                <textFieldExpression><![CDATA[$F{activo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="630" y="0" width="120" height="22"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
