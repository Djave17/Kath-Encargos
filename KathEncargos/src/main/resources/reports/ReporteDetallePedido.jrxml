<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteDetallePedido" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <style name="TableCell">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precioUnitario" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="platillo.nombre" class="java.lang.String"/>

    <title>

        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte Detalles de Pedido]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="0" width="240" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="80" height="80"/>
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="360" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Platillo]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="360" y="0" width="120" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="480" y="0" width="150" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Precio unit.]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="630" y="0" width="172" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="360" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{platillo.nombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="360" y="0" width="120" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="480" y="0" width="150" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="630" y="0" width="172" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>