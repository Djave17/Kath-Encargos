<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteDetallePedido" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

<style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<style name="TableCell">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<field name="idDetallePedido" class="java.lang.Long"/>
<field name="cantidad" class="java.lang.Integer"/>
<field name="precioUnitario" class="java.math.BigDecimal"/>
<field name="subtotal" class="java.math.BigDecimal"/>
<field name="platillo" class="uam.edu.ni.KathEncargos.domain.menu.Platillo"/>
<field name="pedido" class="uam.edu.ni.KathEncargos.domain.pedidos.Pedido"/>

<title>

    <band height="240">
        <staticText>
            <reportElement x="0" y="0" width="802" height="40"/>
            <textElement textAlignment="Center">
                <font size="20" isBold="true"/>
            </textElement>
            <text><![CDATA[Reporte de Detalles de Pedido]]></text>
        </staticText>
        <image scaleImage="RetainShape">
            <reportElement x="286" y="50" width="230" height="180"/>
            <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
        </image>
    </band>
</title>

<columnHeader>
    <band height="24">
        <staticText>
            <reportElement style="TableHeader" x="0" y="0" width="70" height="24"/>
            <text><![CDATA[ID]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="80" y="0" width="110" height="24"/>
            <text><![CDATA[Cantidad]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="200" y="0" width="130" height="24"/>
            <text><![CDATA[Precio unit.]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="340" y="0" width="130" height="24"/>
            <text><![CDATA[Subtotal]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="480" y="0" width="180" height="24"/>
            <text><![CDATA[Platillo]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="670" y="0" width="132" height="24"/>
            <text><![CDATA[Pedido]]></text>
        </staticText>
    </band>
</columnHeader>

<detail>
    <band height="22">
        <textField>
            <reportElement style="TableCell" x="0" y="0" width="70" height="22"/>
            <textFieldExpression><![CDATA[$F{idDetallePedido}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="80" y="0" width="110" height="22"/>
            <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="200" y="0" width="130" height="22"/>
            <textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="340" y="0" width="130" height="22"/>
            <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="480" y="0" width="180" height="22"/>
            <textFieldExpression><![CDATA[$F{platillo}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="670" y="0" width="132" height="22"/>
            <textFieldExpression><![CDATA[$F{pedido}]]></textFieldExpression>
        </textField>
    </band>
</detail>

</jasperReport>
