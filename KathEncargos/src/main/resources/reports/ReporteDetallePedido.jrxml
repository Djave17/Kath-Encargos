<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteDetallePedido" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="TableHeader" mode="Opaque" backcolor="#f4f4f4">
        <box leftPadding="6" rightPadding="6" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.5" lineColor="#9e9e9e"/>
        </box>
    </style>

    <style name="TableCell">
        <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6">
            <pen lineWidth="0.5" lineColor="#c5c5c5"/>
        </box>
    </style>

    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precioUnitario" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="platillo.nombre" class="java.lang.String"/>

    <title>
        <band height="90">
        <image scaleImage="RetainShape">
            <reportElement x="0" y="0" width="70" height="70"/>
            <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
        </image>

            <staticText>
                <reportElement x="80" y="8" width="480" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte Detalles de Pedido]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="40" width="480" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Detalle de platillos solicitados con cantidades y montos.]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="8" width="240" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new
java.util.Date())]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>

        <band height="40">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="360" height="40"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Platillo]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="360" y="0" width="120" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="480" y="0" width="150" height="40"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Precio unitario]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="630" y="0" width="172" height="40"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="360" height="32"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{platillo.nombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="360" y="0" width="120" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField pattern="$ #,##0.00">
                <reportElement style="TableCell" x="480" y="0" width="150" height="32"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression>
            </textField>
            <textField pattern="$ #,##0.00">
                <reportElement style="TableCell" x="630" y="0" width="172" height="32"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>