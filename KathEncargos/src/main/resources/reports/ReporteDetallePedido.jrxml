<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReporteDetallePedido" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <field name="idDetallePedido" class="java.lang.Long"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precioUnitario" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="platillo" class="uam.edu.ni.KathEncargos.domain.menu.Platillo"/>
    <field name="pedido" class="uam.edu.ni.KathEncargos.domain.pedidos.Pedido"/>

    <title>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE DETALLES DE PEDIDO]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="60" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="65" y="0" width="60" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="100" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[Precio unit.]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="90" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="120" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[Platillo]]></text>
            </staticText>
            <staticText>
                <reportElement x="455" y="0" width="100" height="22" backcolor="#F5F5DC" mode="Opaque"/>
                <text><![CDATA[Pedido]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{idDetallePedido}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="65" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="235" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{platillo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{pedido}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>