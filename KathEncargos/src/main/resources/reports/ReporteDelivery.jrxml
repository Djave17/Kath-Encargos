<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteDelivery" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="TableHeader" mode="Opaque" backcolor="#f4f4f4">
        <box leftPadding="6" rightPadding="6" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.5" lineColor="#9e9e9e"/>
        </box>
    </style>

    <style name="TableCell">
        <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6">
            <pen lineWidth="0.5" lineColor="#c5c5c5"/>
        </box>
    </style>

    <field name="nombreRepartidor" class="java.lang.String"/>
    <field name="direccionEntrega" class="java.lang.String"/>
    <field name="telefonoContacto" class="java.lang.String"/>
    <field name="horaSalida" class="java.lang.String"/>
    <field name="horaLlegada" class="java.lang.String"/>

    <title>
        <band height="90">
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="70" height="70"/>
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="80" y="8" width="480" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Deliveries]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="40" width="480" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Información de repartidores, rutas y horarios de entrega.]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="8" width="240" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new
java.util.Date())]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="40">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="220" height="40"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Repartidor]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="220" y="0" width="130" height="40"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Teléfono]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="350" y="0" width="250" height="40"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Dirección]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="600" y="0" width="100" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Salida]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="700" y="0" width="102" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Llegada]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="220" height="32"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nombreRepartidor}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="220" y="0" width="130" height="32"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{telefonoContacto}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="350" y="0" width="250" height="32"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{direccionEntrega}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="600" y="0" width="100" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{horaSalida}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="700" y="0" width="102" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{horaLlegada}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>