<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteDelivery" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

<style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<style name="TableCell">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<field name="oid" class="java.lang.String"/>
<field name="nombreRepartidor" class="java.lang.String"/>
<field name="direccionEntrega" class="java.lang.String"/>
<field name="telefonoContacto" class="java.lang.String"/>
<field name="horaSalida" class="java.lang.String"/>
<field name="horaLlegada" class="java.lang.String"/>

<title>
    <band height="240">
        <staticText>
            <reportElement x="0" y="0" width="802" height="40"/>
            <textElement textAlignment="Center">
                <font size="20" isBold="true"/>
            </textElement>
            <text><![CDATA[Reporte de Deliveries]]></text>
        </staticText>
        <image scaleImage="RetainShape">
            <reportElement x="286" y="50" width="230" height="180"/>
            <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
        </image>
    </band>
</title>

<columnHeader>
    <band height="24">
        <staticText>
            <reportElement style="TableHeader" x="0" y="0" width="70" height="24"/>
            <text><![CDATA[OID]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="80" y="0" width="180" height="24"/>
            <text><![CDATA[Repartidor]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="270" y="0" width="200" height="24"/>
            <text><![CDATA[Dirección]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="480" y="0" width="120" height="24"/>
            <text><![CDATA[Teléfono]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="610" y="0" width="90" height="24"/>
            <text><![CDATA[Salida]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="710" y="0" width="92" height="24"/>
            <text><![CDATA[Llegada]]></text>
        </staticText>
    </band>
</columnHeader>

<detail>
    <band height="22">
        <textField>
            <reportElement style="TableCell" x="0" y="0" width="70" height="22"/>
            <textFieldExpression><![CDATA[$F{oid}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="80" y="0" width="180" height="22"/>
            <textFieldExpression><![CDATA[$F{nombreRepartidor}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="270" y="0" width="200" height="22"/>
            <textFieldExpression><![CDATA[$F{direccionEntrega}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="480" y="0" width="120" height="22"/>
            <textFieldExpression><![CDATA[$F{telefonoContacto}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="610" y="0" width="90" height="22"/>
            <textFieldExpression><![CDATA[$F{horaSalida}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="710" y="0" width="92" height="22"/>
            <textFieldExpression><![CDATA[$F{horaLlegada}]]></textFieldExpression>
        </textField>
    </band>
</detail>

</jasperReport>