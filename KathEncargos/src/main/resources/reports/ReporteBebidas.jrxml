<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">


<jasperReport name="ReporteBebidas" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

<style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>

<style name="TableCell">
    <box>
        <pen lineWidth="1.0" lineColor="#000000"/>
    </box>
</style>


<field name="nombre" class="java.lang.String"/>
<field name="descripcion" class="java.lang.String"/>
<field name="precio" class="java.math.BigDecimal"/>

<title>

    <band height="100">
        <staticText>
            <reportElement x="0" y="0" width="802" height="40"/>
            <textElement textAlignment="Center">
                <font size="20" isBold="true"/>
            </textElement>
            <text><![CDATA[Reporte de Bebidas]]></text>
        </staticText>

        <textField>
            <reportElement x="562" y="0" width="240" height="20"/>
            <textElement textAlignment="Right" verticalAlignment="Middle">
                <font size="10" isBold="true"/>
            </textElement>
            <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
        </textField>

        <image scaleImage="RetainShape">
            <reportElement x="0" y="0" width="80" height="80"/>
            <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
        </image>
    </band>
</title>

<columnHeader>
    <band height="24">
        <staticText>
            <reportElement style="TableHeader" x="0" y="0" width="200" height="24"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <text><![CDATA[Nombre]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="200" y="0" width="420" height="24"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <text><![CDATA[Descripción]]></text>
        </staticText>
        <staticText>
            <reportElement style="TableHeader" x="620" y="0" width="182" height="24"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <text><![CDATA[Precio]]></text>
        </staticText>
    </band>
</columnHeader>

<detail>
    <band height="22">
        <textField>
            <reportElement style="TableCell" x="0" y="0" width="200" height="22"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="200" y="0" width="420" height="22"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
        </textField>
        <textField>
            <reportElement style="TableCell" x="620" y="0" width="182" height="22"/>
            <textElement textAlignment="Center" verticalAlignment="Middle"/>
            <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
        </textField>
    </band>
</detail>

</jasperReport>