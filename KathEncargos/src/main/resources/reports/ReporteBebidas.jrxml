<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<!--
    Reporte Jasper: "ReporteBebidas"
    - Orientación horizontal (Landscape)
    - Ancho y alto definidos para impresión tipo carta apaisada
-->
<jasperReport name="ReporteBebidas" orientation="Landscape" pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!--
        Estilo visual para los encabezados de tabla
        - Fondo gris claro
        - Padding e indicadores de borde
    -->
    <style name="TableHeader" mode="Opaque" backcolor="#f4f4f4">
        <box leftPadding="6" rightPadding="6" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.5" lineColor="#9e9e9e"/>
        </box>
    </style>

    <!--
        Estilo para celdas del detalle
        - Padding mayor para legibilidad
        - Borde suave
    -->
    <style name="TableCell">
        <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6">
            <pen lineWidth="0.5" lineColor="#c5c5c5"/>
        </box>
    </style>

    <!--
        Campos que vendrán desde el DataSource (PrintBebidasReportAction)
        Deben coincidir con getters en la entidad Bebida
    -->
    <field name="nombre" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="precio" class="java.math.BigDecimal"/>

    <!--
        Banda del título del reporte:
        Contiene logo, nombre del reporte, descripción y fecha de generación
    -->
    <title>
        <band height="90">

            <!-- Logo de la empresa -->
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="70" height="70"/>
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>

            <!-- Texto principal del reporte -->
            <staticText>
                <reportElement x="80" y="8" width="480" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Bebidas]]></text>
            </staticText>

            <!-- Subtítulo descriptivo -->
            <staticText>
                <reportElement x="80" y="40" width="480" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Listado de bebidas disponibles con su descripción y precio.]]></text>
            </staticText>

            <!-- Fecha automática de generación -->
            <textField>
                <reportElement x="562" y="8" width="240" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- Encabezado de columnas -->
    <columnHeader>
        <band height="40">

            <!-- Encabezado para el nombre -->
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="240" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <!-- Encabezado para la descripción -->
            <staticText>
                <reportElement style="TableHeader" x="240" y="0" width="382" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Descripción]]></text>
            </staticText>

            <!-- Encabezado para el precio -->
            <staticText>
                <reportElement style="TableHeader" x="622" y="0" width="180" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Precio]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!--
        Banda detalle: aquí se repite una fila por cada registro de bebida
    -->
    <detail>
        <band height="32">

            <!-- Valor del nombre -->
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="240" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <!-- Valor de la descripción -->
            <textField>
                <reportElement style="TableCell" x="240" y="0" width="382" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>

            <!-- Valor del precio con formato monetario -->
            <textField pattern="$ #,##0.00">
                <reportElement style="TableCell" x="622" y="0" width="180" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>
