<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReportePlatillos" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="TableHeader" mode="Opaque" backcolor="#f4f4f4">
        <box leftPadding="6" rightPadding="6" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.5" lineColor="#9e9e9e"/>
        </box>
    </style>

    <style name="TableCell">
        <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6">
            <pen lineWidth="0.5" lineColor="#c5c5c5"/>
        </box>
    </style>

    <field name="nombre" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="precio" class="java.lang.Double"/>
    <field name="guarniciones" class="java.util.Collection"/>
    <field name="bebidas" class="java.util.Collection"/>
    <field name="postres" class="java.util.Collection"/>

    <title>
        <band height="90">
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="70" height="70"/>
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="80" y="8" width="480" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Platillos]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="40" width="480" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Platillos con guarniciones, bebidas, postres y precio.]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="8" width="240" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new
java.util.Date())]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="40">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="150" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="150" y="0" width="260" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Descripción]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="410" y="0" width="120" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Guarniciones]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="530" y="0" width="110" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Bebida]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="640" y="0" width="90" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Postre]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="730" y="0" width="72" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Precio]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="150" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="150" y="0" width="260" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="410" y="0" width="120" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{guarniciones} == null ? "" : $F{guarniciones}.size() + " guarniciones"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="530" y="0" width="110" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{bebidas} == null ? "" : $F{bebidas}.size() + " bebidas"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="TableCell" x="640" y="0" width="90" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{postres} == null ? "" : $F{postres}.size() + " postres"]]></textFieldExpression>
            </textField>

            <textField pattern="$ #,##0.00">
                <reportElement style="TableCell" x="730" y="0" width="72" height="32"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>