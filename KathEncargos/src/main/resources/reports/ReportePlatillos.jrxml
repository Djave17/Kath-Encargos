<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReportePlatillos" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Estilos iguales a ReporteUsuarios -->
    <style name="TableHeader" mode="Opaque" backcolor="#E6E6E6">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <style name="TableCell">
        <box>
            <pen lineWidth="1.0" lineColor="#000000"/>
        </box>
    </style>

    <!-- Campos de Platillo -->
    <field name="nombre" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="precio" class="java.lang.Double"/>
    <field name="guarniciones" class="java.util.Collection"/>
    <field name="bebida" class="uam.edu.ni.KathEncargos.domain.menu.Bebida"/>
    <field name="postre" class="uam.edu.ni.KathEncargos.domain.menu.Postre"/>

    <!-- Título con logo -->
    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Platillos]]></text>
            </staticText>

            <textField>
                <reportElement x="562" y="0" width="240" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de generación: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="80" height="80"/>
                <!-- mismo logo que en usuarios -->
                <imageExpression><![CDATA["reports/Logo_Kath_encargosss.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <!-- Encabezado (sin ID, con bordes) -->
    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="150" height="24"/>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="150" y="0" width="260" height="24"/>
                <text><![CDATA[Descripción]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="410" y="0" width="120" height="24"/>
                <text><![CDATA[Guarniciones]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="530" y="0" width="110" height="24"/>
                <text><![CDATA[Bebida]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="640" y="0" width="90" height="24"/>
                <text><![CDATA[Postre]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="730" y="0" width="72" height="24"/>
                <text><![CDATA[Precio]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Filas de datos -->
    <detail>
        <band height="22">

            <!-- Nombre -->
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="150" height="22"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <!-- Descripción -->
            <textField>
                <reportElement style="TableCell" x="150" y="0" width="260" height="22"/>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>

            <!-- Guarniciones: mostramos cantidad, no el objeto feo -->
            <textField>
                <reportElement style="TableCell" x="410" y="0" width="120" height="22"/>
                <textFieldExpression><![CDATA[
                    $F{guarniciones} == null
                        ? ""
                        : $F{guarniciones}.size() + " guarniciones"
                ]]></textFieldExpression>
            </textField>

            <!-- Bebida: mostramos el nombre, no el objeto -->
            <textField>
                <reportElement style="TableCell" x="530" y="0" width="110" height="22"/>
                <textFieldExpression><![CDATA[
                    $F{bebida} == null
                        ? ""
                        : $F{bebida}.getNombre()
                ]]></textFieldExpression>
            </textField>

            <!-- Postre: también el nombre -->
            <textField>
                <reportElement style="TableCell" x="640" y="0" width="90" height="22"/>
                <textFieldExpression><![CDATA[
                    $F{postre} == null
                        ? ""
                        : $F{postre}.getNombre()
                ]]></textFieldExpression>
            </textField>

            <!-- Precio -->
            <textField>
                <reportElement style="TableCell" x="730" y="0" width="72" height="22"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>